#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

//roll 

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    ctrl_mb1: ctrl_mb1 {
        compatible = "zmk,behavior-hold-tap";
        label = "CTRL_MB1";
        bindings = <&mkp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB         &kp Q       &kp W       &kp E        &kp R          &kp T          &ctrl_mb1 MB1 Y  &kp U         &kp I        &kp O       &kp P          &kp BSLH
&kp LEFT_SHIFT  &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHIFT F   &kp G          &mt LS(F10) H    &mt RSHIFT J  &mt RCTRL K  &mt RALT L  &mt RGUI SEMI  &kp APOS
&lt 5 LCTRL     &kp Z       &kp X       &kp C        &kp V          &kp B          &kp N            &kp M         &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
                                        &mo 3        &kp BACKSPACE  &lt 1 SPACE    &lt 2 ENTER      &kp DEL       &mo 4
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动            
            //ec11-VOL：sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&kp LC(LS(ESC))  &none     &none     &none      &none      &none    &kp LBKT         &kp KP_N7        &kp KP_N8  &kp KP_N9  &kp RBKT       &kp DEL
&kp CAPS         &none     &none     &none      &none      &none    &kp KP_PLUS      &kp KP_N4        &kp KP_N5  &kp KP_N6  &kp KP_MINUS   &kp BACKSPACE
&kp KP_NUMLOCK   &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp KP_MULTIPLY  &kp KP_NUMBER_1  &kp KP_N2  &kp KP_N3  &kp KP_DIVIDE  &kp KP_EQUAL
                                     &none      &none      &none    &kp KP_ENTER     &kp KP_N0        &none
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                // 编码器1：左右滚动    ,,,,
                <&scroll_vertical_encoder>;

            // 编码器2：上下滚动
        };

        layer_2 {
            bindings = <
&kp ESC        &kp LC(W)   &kp LC(PAGE_UP)  &kp LG(UP)    &kp LC(PAGE_DOWN)  &trans    &kp PAGE_UP    &kp HOME  &kp UP    &kp END    &kp PRINTSCREEN  &kp C_VOL_UP
&kp LS(LG(S))  &kp LA(F4)  &kp LG(LEFT)     &kp LG(DOWN)  &kp LG(RIGHT)      &none     &kp PAGE_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp INS          &kp K_MUTE
&trans         &kp LGUI    &kp LALT         &kp LCTRL     &kp LSHFT          &none     &trans         &trans    &trans    &trans     &trans           &kp C_VOL_DN
                                            &trans        &trans             &none     &trans         &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp UNDERSCORE
&trans  &trans    &trans    &trans     &trans     &trans    &trans     &trans    &trans     &trans    &trans    &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &trans     &trans    &trans     &trans    &trans    &trans
                            &trans     &trans     &trans    &trans     &trans    &trans
            >;
        };

        layer_4 {
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &trans  &trans      &trans     &trans    &trans    &trans
&trans     &trans    &trans  &trans    &trans    &trans       &trans  &trans      &trans     &trans    &trans    &trans
&trans     &trans    &trans  &trans    &trans    &trans       &trans  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
                             &trans    &trans    &trans       &trans  &trans      &trans
            >;
        };

        layer_5 {
            bindings = <
&kp LC(ESC)  &kp LC(Q)  &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)    &kp LC(Y)    &kp LC(U)    &kp LC(I)  &kp LC(O)  &kp LC(P)  &trans
&kp LSHFT    &kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(G)    &kp LC(H)    &kp LC(K)    &kp LC(L)  &kp LC(L)  &trans     &trans
&trans       &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)    &kp LC(N)    &kp LC(M)    &trans     &trans     &trans     &trans
                                   &trans     &trans     &kp BSPC     &kp LC(RET)  &kp LC(DEL)  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_10 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
